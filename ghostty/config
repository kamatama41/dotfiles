# Ghostty config
# リロード: cmd+shift+,  /  テーマ一覧: ghostty +list-themes

# --- Font ---
# デフォルトで JetBrains Mono + Nerd Font のアイコンが内蔵されている
# 別のフォントにする場合: font-family = "HackGen Console NF"
font-size = 14
font-thicken = true

# --- Appearance ---
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
background-opacity = 0.95
background-blur = 20
macos-titlebar-style = tabs
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
window-save-state = always

# --- Input ---
# Option を Alt (Meta) として使う（nvim / zsh の Alt キーバインド用）
macos-option-as-alt = true
copy-on-select = clipboard
confirm-close-surface = false

# --- Shell integration ---
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- Splits ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:bottom
keybind = cmd+alt+k=goto_split:top
keybind = cmd+alt+l=goto_split:right
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+alt+equal=equalize_splits

# --- Quick terminal (どのアプリからでも cmd+` で呼び出し) ---
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
keybind = global:cmd+grave_accent=toggle_quick_terminal
